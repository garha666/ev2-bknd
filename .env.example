# ============================================================================
# Ejemplo de variables de entorno para el backend EVA-2
# Copiar a .env y ajustar los valores según el entorno local.
# ============================================================================

DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL (prohibido SQLite por la pauta)
DB_NAME=tickets_db
DB_USER=postgres
DB_PASSWORD=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS (True sólo en desarrollo)
CORS_ALLOW_ALL_ORIGINS=True
